# Copy to .env and fill in, or run `npm run init-env` to generate one with random secrets.

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=covidweb
DB_USER=covidweb
DB_PASS=[INSERT_DB_PASSWORD]
# Only used by docker compose to initialise MySQL
DB_ROOT_PASS=[INSERT_DB_ROOT_PASSWORD]

# Map pages (doctors), optional. Without them the map shows OpenStreetMap and
# cannot geocode addresses. Restrict both keys to your domain in their consoles.
MAPBOX_TOKEN=
ESRI_API_KEY=

# Deploy webhook. Leave the secret empty to disable the /github route.
GITHUB_WEBHOOK_SECRET=
DEPLOY_DIR=
DEPLOY_BRANCH=master

# Optional
# HTTP_PORT=3000
# TRUST_PROXY=1     # set when running behind exactly one reverse proxy
# COOKIE_SECURE=0   # only for plain HTTP on a host other than localhost; do not use in production
