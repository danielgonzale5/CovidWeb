{
  "name": "covidweb",
  "version": "2.0.0",
  "private": true,
  "description": "COVID-19 case management: patient intake, case tracking, case map and a public dashboard.",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test test/*.test.js",
    "init-env": "node scripts/init-env.js",
    "create-user": "node --env-file-if-exists=.env scripts/create-user.js"
  },
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "mysql2": "^3.24.5"
  }
}
